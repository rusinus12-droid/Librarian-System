    {
      "id": "UME-01",
      "category": "multi_family_synthesis",
      "label": "4대 자료 복합 연결 (정본·Micro·State·Lore 단일 탐색)",
      "description": "한 질문에서 정본 역사, 단기 사건, 현재 상태, 세계관 설정이 유기적으로 연결되어야 함",
      "corpus": {
        "scopeKey": "eval-scope-01",
        "canonical": [
          {"nodeId": "c_key_history", "recordKey": "rec_canon_key", "turn": 5, "text": "앨리스는 은빛 열쇠를 제작하여 서재에 보관하기 시작했다."}
        ],
        "micro": [
          {"nodeId": "m_key_action", "recordKey": "rec_micro_key", "turn": 12, "text": "앨리스는 서재 문을 열고 은빛 열쇠를 서랍에 넣었다."}
        ],
        "state": [
          {"nodeId": "s_key_current", "recordKey": "rec_state_key", "turn": 15, "text": "은빛 열쇠의 현재 위치는 서재 책상 안쪽 비밀 서랍이다."}
        ],
        "lore": [
          {"nodeId": "l_key_lore", "locator": "lore:silver_key", "text": "은빛 열쇠는 고대 서재의 봉인을 해제하는 특수 아티팩트다.", "mandatoryInclusion": false}
        ],
        "edges": [
          {"from": "c_key_history", "to": "s_key_current", "predicate": "updates"},
          {"from": "s_key_current", "to": "l_key_lore", "predicate": "applies_to"},
          {"from": "m_key_action", "to": "c_key_history", "predicate": "corroborates"}
        ]
      },
      "query": {
        "queryText": "은빛 열쇠의 현재 위치와 용도",
        "asOfTurn": 15,
        "viewerId": "owner_reader",
        "worldlineId": "main",
        "consumerPolicy": {"consumer": "classic", "maxCharacters": 4096, "maxUnits": 10}
      },
      "expected": {
        "goldNodeIds": ["s_key_current", "l_key_lore", "c_key_history"],
        "requiredFamilies": ["canonical", "state", "lore"],
        "deliveryOutcome": "complete",
        "modelDispatchEligible": true
      },
