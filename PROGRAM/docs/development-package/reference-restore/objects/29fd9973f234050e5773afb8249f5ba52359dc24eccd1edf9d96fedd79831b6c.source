__pycache__/
*.py[cod]
.cache/
.npm/
.venv/
venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Runtime/user storage is private and never part of development source.
DATA/
data/
.data/
/PROGRAM/stores/
/stores/
/UPDATER/update-state.json
/PROGRAM/_runtime/*
!/PROGRAM/_runtime/README.txt

